# Where the whole UI (catalog pages and chat) reads from. Restart `npm run dev` after changing it.
#   seed   = the UI's own data in src/data, no backend (default)
#   corpus = the FastAPI backend over corpus/finflow
VITE_DATA_SOURCE=seed

# The URL path the app is served from (dev server, preview and build). Default: /decision-os/
# Set VITE_BASE=/ to serve from the root.
# VITE_BASE=/decision-os/
